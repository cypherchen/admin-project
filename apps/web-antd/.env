# 应用标题
VITE_APP_TITLE=CATL成本分析数据管理平台

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=cx-CATL-web

# 0:生产环境, 1:测试环境
VITE_GLOB_ENV_TYPE=0

# 生产环境单点登录地址
VITE_GLOB_SSO_URL_PROD=https://iam.catl.com/esc-sso/oauth2.0/authorize

# 测试环境单点登录地址
VITE_GLOB_SSO_URL_TEST=https://iamsit.catl.com/esc-sso/oauth2.0/authorize

# 生产环境单点登录ID
VITE_GLOB_SSO_CLIENT_ID_PROD=b665ed04db386c4f3648

# 测试环境单点登录ID
VITE_GLOB_SSO_CLIENT_ID_TEST=99ab590641fb68466a78
